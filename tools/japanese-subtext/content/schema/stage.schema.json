{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lusu575.com/tools/japanese-subtext/content/schema/stage.schema.json",
  "title": "日本語の裏側 stage",
  "type": "object",
  "required": [
    "schemaVersion", "contentVersion", "id", "revision", "level", "stage",
    "jlptTarget", "genres", "skills", "layout", "title", "setting", "illustration",
    "cast", "lines", "questions", "audio", "passRule", "contentRating", "textLocked"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^L[1-5]-[0-9]{3}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "stage": { "type": "integer", "minimum": 1, "maximum": 50 },
    "jlptTarget": { "enum": ["N3", "N2", "N1", "N1-advanced", "N1-pragmatics"] },
    "genres": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "layout": {
      "enum": [
        "dialogue", "multi-dialogue", "phone-chat", "group-chat", "voice-message",
        "phone-call", "school-broadcast", "news", "spaceship-log", "ai-system",
        "meeting", "interview", "party-voice", "vrchat", "diary", "dream-log",
        "station-broadcast", "quest-log", "error-dialog", "four-panel", "short-story"
      ]
    },
    "title": { "$ref": "#/$defs/localized" },
    "setting": { "$ref": "#/$defs/localized" },
    "illustration": {
      "type": "object",
      "required": ["enabled", "src", "style", "sha256", "alt"],
      "properties": {
        "enabled": { "type": "boolean" },
        "src": { "type": "string" },
        "style": { "enum": ["monochrome-four-panel"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "alt": { "$ref": "#/$defs/localizedAllowEmpty" }
      },
      "additionalProperties": false
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "voiceKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "name": { "$ref": "#/$defs/localized" },
          "voiceKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" }
        },
        "additionalProperties": false
      }
    },
    "lines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "speaker", "text", "readingJa", "ttsTextJa", "audioId", "tokens"],
        "properties": {
          "id": { "type": "string", "pattern": "^line-[0-9]{3}$" },
          "speaker": { "type": "string" },
          "text": { "$ref": "#/$defs/localized" },
          "readingJa": { "type": "string", "minLength": 1 },
          "ttsTextJa": { "type": "string", "minLength": 1 },
          "audioId": { "type": "string", "pattern": "^L[1-5]-[0-9]{3}-line-[0-9]{3}$" },
          "pauseAfterMs": { "type": "integer", "minimum": 0, "maximum": 3000 },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text", "reading", "audioId"],
              "properties": {
                "id": { "type": "string", "pattern": "^token-[0-9]{3}$" },
                "text": { "type": "string", "minLength": 1 },
                "reading": { "type": "string", "minLength": 1 },
                "audioId": { "type": "string", "pattern": "^L[1-5]-[0-9]{3}-line-[0-9]{3}-token-[0-9]{3}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "type", "prompt", "options", "correctOptionIds", "evidenceLineIds", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-5]$" },
          "type": { "enum": ["single", "multiple"] },
          "prompt": { "$ref": "#/$defs/localized" },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["id", "text", "ttsTextJa", "readingJa", "audioId"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-f]$" },
                "text": { "$ref": "#/$defs/localized" },
                "ttsTextJa": { "type": "string", "minLength": 1 },
                "readingJa": { "type": "string", "minLength": 1 },
                "audioId": { "type": "string", "pattern": "^L[1-5]-[0-9]{3}-q[1-5]-[a-f]$" }
              },
              "additionalProperties": false
            }
          },
          "correctOptionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f]$" } },
          "evidenceLineIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^line-[0-9]{3}$" } },
          "explanation": {
            "type": "object",
            "required": ["literal", "intent", "evidence", "nuance", "alternative"],
            "properties": {
              "literal": { "$ref": "#/$defs/localized" },
              "intent": { "$ref": "#/$defs/localized" },
              "evidence": { "$ref": "#/$defs/localized" },
              "nuance": { "$ref": "#/$defs/localized" },
              "alternative": { "$ref": "#/$defs/localized" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "required": ["sceneAudioId", "timelineId", "optionVoiceKey"],
      "properties": {
        "sceneAudioId": { "type": "string", "pattern": "^L[1-5]-[0-9]{3}-scene$" },
        "timelineId": { "type": "string", "pattern": "^L[1-5]-[0-9]{3}-timeline$" },
        "optionVoiceKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" }
      },
      "additionalProperties": false
    },
    "passRule": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "all_questions_correct" } },
      "additionalProperties": false
    },
    "contentRating": { "const": "general" },
    "textLocked": { "type": "boolean" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["ja", "zh", "en"],
      "properties": {
        "ja": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "localizedAllowEmpty": {
      "type": "object",
      "required": ["ja", "zh", "en"],
      "properties": {
        "ja": { "type": "string" },
        "zh": { "type": "string" },
        "en": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
