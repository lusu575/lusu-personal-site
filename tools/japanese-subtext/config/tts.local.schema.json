{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japanese Subtext local AivisSpeech TTS configuration",
  "type": "object",
  "required": [
    "adapter",
    "ffmpeg",
    "ffprobe",
    "audioBaseUrl",
    "aivis",
    "output",
    "voices",
    "voiceAliases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "adapter": { "const": "aivisspeech-engine" },
    "ffmpeg": { "type": "string", "minLength": 1 },
    "ffprobe": { "type": "string", "minLength": 1 },
    "audioBaseUrl": { "type": "string", "minLength": 1 },
    "aivis": {
      "type": "object",
      "required": [
        "baseUrl",
        "engineVersion",
        "provider",
        "timeoutSeconds",
        "verifyModelFiles",
        "models"
      ],
      "properties": {
        "baseUrl": {
          "enum": ["http://127.0.0.1:10103", "http://localhost:10103"]
        },
        "engineVersion": { "const": "1.2.0" },
        "provider": { "const": "CPU" },
        "timeoutSeconds": { "type": "number", "minimum": 1, "maximum": 600 },
        "verifyModelFiles": { "type": "boolean" },
        "models": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/model" }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "format",
        "sampleRate",
        "channels",
        "bitrate",
        "targetLufs",
        "leadingSilenceMs",
        "trailingSilenceMs",
        "sceneGapMs"
      ],
      "properties": {
        "format": { "const": "mp3" },
        "sampleRate": { "const": 44100 },
        "channels": { "const": 1 },
        "bitrate": { "const": "96k" },
        "targetLufs": { "type": "number", "minimum": -30, "maximum": -10 },
        "leadingSilenceMs": { "type": "integer", "minimum": 20, "maximum": 500 },
        "trailingSilenceMs": { "type": "integer", "minimum": 40, "maximum": 500 },
        "sceneGapMs": { "type": "integer", "minimum": 0, "maximum": 3000 }
      },
      "additionalProperties": false
    },
    "voices": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": { "$ref": "#/$defs/voice" }
    },
    "voiceAliases": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["uuid", "version", "sha256", "license"],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license": { "const": "ACML-1.0" }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "required": [
        "modelUuid",
        "styleName",
        "speedScale",
        "pitchScale",
        "intonationScale",
        "volumeScale",
        "prePhonemeLength",
        "postPhonemeLength",
        "pauseLength",
        "pauseLengthScale"
      ],
      "properties": {
        "modelUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "styleName": { "type": "string", "minLength": 1 },
        "speedScale": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "pitchScale": { "type": "number", "minimum": -0.15, "maximum": 0.15 },
        "intonationScale": { "type": "number", "minimum": 0, "maximum": 2 },
        "volumeScale": { "type": "number", "minimum": 0, "maximum": 2 },
        "prePhonemeLength": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "postPhonemeLength": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "pauseLength": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 2 }
          ]
        },
        "pauseLengthScale": { "type": "number", "minimum": 0, "maximum": 2 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
