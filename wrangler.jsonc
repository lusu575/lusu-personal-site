{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lusu-personal-site",
  "compatibility_date": "2026-06-09",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lusu_personal_site",
      "database_id": "replace-with-your-d1-database-id"
    }
  ]
}
