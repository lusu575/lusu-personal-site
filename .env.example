# For local development, copy this file to .dev.vars and fill the values.
# In GPTWork, configure all names as process-environment Secrets and do not create .dev.vars.
# Use two independent cryptographically random salts of at least 32 UTF-8 bytes.
# OWNER_ADMIN_EMAILS accepts comma-, semicolon-, or whitespace-separated email addresses.
# Never commit real values.
CHAT_IP_HASH_SALT=
ANALYTICS_IP_HASH_SALT=
OWNER_ADMIN_EMAILS=
