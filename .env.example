# For local development, copy this file to .dev.vars and fill the values.
# In GPTWork, configure all names as process-environment Secrets and do not create .dev.vars.
# Use independent cryptographically random values of at least 32 UTF-8 bytes.
# OWNER_ADMIN_EMAILS accepts comma-, semicolon-, or whitespace-separated email addresses.
# It protects an existing D1 admin from rename/demotion and blocks public registration for that address.
# It never grants admin by itself; provision the D1 role through a controlled administrator path first.
# Never commit real values.
CHAT_IP_HASH_SALT=
ANALYTICS_IP_HASH_SALT=
OWNER_ADMIN_EMAILS=
# Whiteboard passwords are mapped only on the server with this HMAC secret.
WHITEBOARD_ROOM_HMAC_SECRET=
# Signs and encrypts short WebSocket tickets and room access tokens.
WHITEBOARD_TICKET_SECRET=
# Authenticates Pages Functions calls to the whiteboard Durable Object Worker.
WHITEBOARD_INTERNAL_SECRET=
# Produces a purpose-specific one-way IP hash for whiteboard abuse controls.
WHITEBOARD_IP_HASH_SALT=
