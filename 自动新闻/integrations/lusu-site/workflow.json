{
  "schemaVersion": 4,
  "calendar": {
    "timezone": "Asia/Shanghai",
    "mode": "fixed-24-hour-window",
    "windowHours": 24,
    "windowSemantics": "left-closed-right-open",
    "windowStartLocalTime": "07:00",
    "windowEndLocalTime": "07:00",
    "generationStartLocalTime": "07:00",
    "publishDeadlineLocalTime": "08:00",
    "datePrecisionPolicy": "exact-timestamp-required",
    "deadlinePolicy": "fail-closed",
    "historicalOneShot": {
      "reportDate": "2026-07-27",
      "windowStart": "2026-07-26T23:00:00+08:00",
      "windowEnd": "2026-07-27T23:00:00+08:00",
      "requiresExplicitFlag": "--one-shot-history"
    },
    "manualRecovery": {
      "authorizationSource": "explicit-site-owner-request-in-interactive-codex-task",
      "automaticSchedulerAllowed": false,
      "allowedFromLocalTime": "08:00",
      "expiresAtLocalTime": "next-day-00:00",
      "sameShanghaiCalendarDayOnly": true,
      "requiresExplicitFlag": "--manual-recovery",
      "requiresConfirmations": [
        "--confirm-report-date",
        "--confirm-run-sha256"
      ],
      "runFingerprint": "canonical-json-sha256",
      "preserveFormalValidation": true
    }
  },
  "collection": {
    "engine": "Horizon",
    "required": true,
    "config": "horizon.config.json",
    "entrypoint": "fetch-with-horizon.py",
    "nativeStages": [
      "multi-source-fetch",
      "url-normalization",
      "cross-source-deduplication"
    ],
    "stopWhenUnavailable": true,
    "discoveryCatalog": "discovery-queries.json",
    "languagePolicy": "any-reliable-language",
    "seedLanguages": [
      "en",
      "zh-CN",
      "ja",
      "ko"
    ],
    "queryConcurrency": 2,
    "candidateIndexRequired": true,
    "coverageManifestRequired": true,
    "coverageManifestSchemaVersion": 2,
    "requiredQueryFailurePolicy": "fail-closed",
    "requiredQueryResultLimitProbe": "request-maxResults-plus-one",
    "coverageReview": {
      "reviewEveryRequiredQuery": true,
      "reviewEveryRequiredGroup": true,
      "priorityGroupsFirst": true,
      "mustReviewCandidateSource": "coverage_manifest.json.mustReviewCandidateIds",
      "mustReviewScope": "all-discovered-candidates",
      "priorityReviewPolicy": "all-discovered-candidates",
      "priorityCandidateReviewRequired": true,
      "lowVolumeTrigger": 5,
      "lowVolumeMeaning": "selected-story-count",
      "lowVolumeAction": "mandatory-second-pass-without-filler"
    }
  },
  "selection": {
    "importanceThreshold": 7,
    "maxItems": null,
    "dedupeWithinRun": true,
    "dedupeLookbackDays": 30,
    "allowRepeatOnlyForMaterialUpdate": true,
    "eventDedupe": {
      "identity": "eventKey-plus-eventStage",
      "requiredFields": [
        "eventKey",
        "eventStage",
        "dedupeDecision"
      ],
      "allowedDecisions": [
        "new",
        "material-update",
        "duplicate"
      ],
      "selectedDuplicateAllowed": false,
      "materialUpdateRequires": [
        "priorStoryKey",
        "materialDifference"
      ],
      "materialStages": [
        "announcement",
        "preview",
        "release",
        "weights-release",
        "license",
        "technical-report",
        "deployment",
        "financing",
        "regulatory-decision"
      ]
    },
    "coverageAuditRequired": true,
    "coverageAuditContract": {
      "requiredFields": [
        "candidateIndexReviewedAt",
        "candidateIndexSha256",
        "lowVolumeTrigger",
        "signedOffQueryIds",
        "signedOffGroupIds",
        "priorityReview",
        "secondPass"
      ],
      "priorityReviewWhen": "coverage-manifest-declares-mustReviewCandidateIds",
      "priorityReviewScope": "exactly-every-mustReviewCandidateId-once",
      "signoffSource": "coverage_manifest.json",
      "signedOffQueryIds": "exactly-all-requiredQueryIds",
      "signedOffGroupIds": "exactly-all-requiredGroupIds",
      "secondPassWhen": "selected-story-count-below-5",
      "secondPassRepeatsAllRequiredSignoffs": true,
      "secondPassCompletedAt": "strictly-after-candidateIndexReviewedAt",
      "secondPassReconsideredCandidateIds": "must-include-all-editorial-signal-candidates-plus-all-rss-candidates-plus-protected-class-score-5-or-6-rejections; additional-index-candidates-allowed"
    },
    "priorityReviewContract": {
      "decisions": [
        "selected",
        "merged",
        "rejected"
      ],
      "requiredDecisionFields": [
        "candidateId",
        "decision",
        "editorialClass",
        "substantiveChange",
        "score"
      ],
      "score": {
        "reach": [
          0,
          2
        ],
        "magnitude": [
          0,
          3
        ],
        "practicalValue": [
          0,
          3
        ],
        "evidence": [
          0,
          2
        ],
        "total": [
          0,
          10
        ],
        "totalMustEqualComponentSum": true
      },
      "editorialClasses": [
        "major-model-product",
        "capability-availability",
        "usage-policy",
        "developer-tool",
        "material-price-quota",
        "strategic-hardware-infrastructure",
        "major-tech-finance",
        "ai-policy-safety",
        "other"
      ],
      "protectedEditorialClasses": [
        "major-model-product",
        "capability-availability",
        "usage-policy",
        "developer-tool",
        "material-price-quota",
        "strategic-hardware-infrastructure",
        "major-tech-finance",
        "ai-policy-safety"
      ],
      "protectedSelectionThreshold": 7,
      "protectedAtOrAboveThreshold": "must-be-selected-or-merged",
      "protectedSelectedOrMergedRequiresSubstantiveChange": true,
      "candidateEditorialSignals": {
        "major-model-product-change": {
          "requiredEditorialClass": [
            "major-model-product"
          ]
        },
        "capability-availability-change": {
          "requiredEditorialClass": [
            "capability-availability"
          ]
        },
        "developer-tool-change": {
          "requiredEditorialClass": [
            "developer-tool"
          ]
        },
        "material-price-quota-change": {
          "requiredEditorialClass": [
            "material-price-quota"
          ]
        },
        "strategic-hardware-infrastructure-change": {
          "requiredEditorialClass": [
            "strategic-hardware-infrastructure"
          ]
        },
        "major-tech-finance-change": {
          "requiredEditorialClass": [
            "major-tech-finance"
          ]
        },
        "ai-policy-safety-change": {
          "requiredEditorialClass": [
            "ai-policy-safety"
          ]
        },
        "usage-policy-change": {
          "requiredEditorialClass": [
            "usage-policy",
            "material-price-quota"
          ],
          "forbiddenRejectionReasons": [
            "below-importance-threshold",
            "routine-or-promotional",
            "outside-editorial-scope"
          ]
        }
      },
      "signalCombinationPolicy": {
        "specializedPrecedence": [
          "usage-policy-change",
          "material-price-quota-change",
          "major-tech-finance-change",
          "ai-policy-safety-change",
          "strategic-hardware-infrastructure-change"
        ],
        "compatibleProductSignalClasses": [
          "major-model-product",
          "capability-availability",
          "developer-tool"
        ],
        "rule": "highest-precedence-specialized-signal-wins; otherwise-any-present-compatible-product-class-is-allowed"
      },
      "selectedRequires": [
        "storyKey",
        "sourceCandidateIds"
      ],
      "mergedRequires": [
        "representativeCandidateId",
        "representative-decision-selected",
        "representative-sourceCandidateIds-includes-merged-candidate"
      ],
      "rejectedRequires": [
        "rejectionReason",
        "note"
      ],
      "allowedRejectionReasons": [
        "insufficient-evidence",
        "below-importance-threshold",
        "routine-or-promotional",
        "outside-editorial-scope",
        "no-material-change"
      ],
      "rejectionSemanticRules": {
        "below-importance-threshold": "substantiveChange-must-be-true",
        "no-material-change": "substantiveChange-must-be-false"
      },
      "reviewIntegrity": {
        "minimumCandidateCount": 50,
        "rejectAllOtherClassification": true,
        "rejectDominantIdenticalRejectedEditorialClassAndScoreSignatureRatio": 0.9
      },
      "protectedCandidatesMayBeRejected": false
    },
    "lowVolumeTrigger": 5,
    "lowVolumeRule": "Fewer than five selected stories requires a complete second coverage pass, but never lowers the importance threshold or forces filler.",
    "editorialScoring": "Codex applies Horizon-compatible importance criteria to the current Horizon candidate artifact",
    "selectedItemContract": {
      "requiredFields": [
        "section",
        "verification",
        "aiTake",
        "sourceCandidateIds"
      ],
      "aiTakeStyle": "brief-specific-useful",
      "aiTakeMinCharacters": 12,
      "aiTakeSentenceRange": [
        1,
        2
      ],
      "aiTakeMaxCharacters": 240
    },
    "sections": {
      "order": [
        "lead",
        "main",
        "rumor"
      ],
      "lead": {
        "exactItems": 1,
        "verification": "confirmed"
      },
      "main": {
        "maxItems": null,
        "verification": "confirmed"
      },
      "rumor": {
        "maxItems": null,
        "verification": "unverified",
        "requiresWhyUnverified": true
      }
    }
  },
  "evidence": {
    "preferPrimarySources": true,
    "allowRumors": true,
    "rumorPolicy": "Rumors are allowed only in the isolated rumor section, must use conditional language, and must never be stated as fact. Do not repeat an unverified disclaimer inside every item.",
    "keepSourceUrlsInternalOnly": true
  },
  "article": {
    "styleGuide": "ARTICLE_STYLE.md",
    "format": "single-complete-article",
    "languages": [
      "zh",
      "en",
      "ja"
    ],
    "includeLinks": false,
    "includeReferencesSection": false,
    "includeScores": false,
    "includeSourceLabels": false,
    "titlePatterns": {
      "zh": "每日 AI 新闻｜<今日要闻标题>",
      "en": "Daily AI News | <Lead Story headline>",
      "ja": "毎日AIニュース｜<今日のトップニュース見出し>"
    },
    "titleUsesLeadStoryHeadline": true,
    "titleIncludesDate": false,
    "intro": {
      "allowed": false,
      "firstContentAfterTitle": "lead-section-heading",
      "windowDetailsInternalOnly": true
    },
    "tableOfContents": {
      "generatedBySite": true,
      "manualTableOfContents": false,
      "sourceHeadings": "story-headings-only",
      "includeEveryStoryHeading": true,
      "requireUniqueStoryHeadings": true
    },
    "sectionOrder": [
      "lead",
      "main",
      "rumor"
    ],
    "storyFormat": {
      "headingLevel": 3,
      "headlineStyle": "neutral-factual-no-clickbait",
      "bodyStyle": "fact-first-neutral",
      "preferredBodyParagraphs": 1,
      "preferredBodySentenceRange": [
        1,
        3
      ],
      "attributePublisherClaims": true
    },
    "requirePerItemAiTake": true,
    "aiTake": {
      "sentenceRange": [
        1,
        2
      ],
      "mustBeShorterThanStoryBody": true,
      "maxStoryBodyLengthRatio": 0.8,
      "allowedFocus": [
        "impact",
        "cost-or-access-threshold",
        "hidden-limit",
        "next-evidence"
      ],
      "forbidNewsRestatement": true,
      "forbidGenericFiller": true,
      "forbidForcedCriticism": true,
      "forbidUnsupportedFacts": true
    },
    "rumorPresentation": {
      "useConditionalLanguage": true,
      "forbidPerItemVerificationLabel": true,
      "sectionHeadingIsSufficientDisclosure": true
    },
    "endAfterRumorSection": true,
    "rumorsExcludedFromHeadlineAndOverallConclusion": true
  },
  "delivery": {
    "target": "daily-ai-news",
    "mode": "production-auto-publish",
    "endpoint": "/api/automation/daily-ai-news",
    "productionOrigin": "https://lusu575.com",
    "tokenEnvironmentVariable": "DAILY_AI_NEWS_TOKEN",
    "expectedResponseStatus": "published",
    "postPublishVerification": {
      "languages": [
        "zh",
        "en",
        "ja"
      ],
      "requiredFields": [
        "slug",
        "category",
        "lang",
        "title",
        "content_markdown"
      ],
      "mustFinishBeforeDeadline": true,
      "retry": {
        "method": "GET-only",
        "maxAttemptsPerLanguage": 3,
        "transientFailures": [
          "network-error",
          408,
          425,
          429,
          500,
          502,
          503,
          504
        ],
        "payloadMismatchRetry": false,
        "productionPostRetry": false
      }
    },
    "autoPublish": true,
    "schedulerEnabled": true,
    "failurePolicy": "fail-closed",
    "automaticLatePublishForbidden": true,
    "manualRecoveryReference": "MANUAL_RECOVERY.md"
  },
  "compatibility": {
    "formalRunSchemaVersion": 4,
    "historicalOneShotSchemaVersion": 3,
    "historicalSchema3OnlyForExplicitOneShot": true
  }
}
