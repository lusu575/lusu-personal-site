{
  "schemaVersion": 4,
  "calendar": {
    "timezone": "Asia/Shanghai",
    "mode": "fixed-24-hour-window",
    "windowHours": 24,
    "windowSemantics": "left-closed-right-open",
    "windowStartLocalTime": "07:00",
    "windowEndLocalTime": "07:00",
    "generationStartLocalTime": "07:00",
    "publishDeadlineLocalTime": "next-day-00:00",
    "datePrecisionPolicy": "exact-timestamp-required",
    "deadlinePolicy": "same-report-date-fail-closed",
    "historicalOneShot": {
      "reportDate": "2026-07-27",
      "windowStart": "2026-07-26T23:00:00+08:00",
      "windowEnd": "2026-07-27T23:00:00+08:00",
      "requiresExplicitFlag": "--one-shot-history"
    },
    "manualRecovery": {
      "authorizationSource": "explicit-site-owner-request-in-interactive-codex-task",
      "automaticSchedulerAllowed": false,
      "allowedFromLocalTime": "07:00",
      "expiresAtLocalTime": "next-day-00:00",
      "sameShanghaiCalendarDayOnly": true,
      "requiresExplicitFlag": "--manual-recovery",
      "requiresConfirmations": [
        "--confirm-report-date",
        "--confirm-run-sha256"
      ],
      "runFingerprint": "canonical-json-sha256",
      "preserveFormalValidation": true
    }
  },
  "collection": {
    "engine": "Horizon",
    "required": true,
    "config": "horizon.config.json",
    "entrypoint": "fetch-with-horizon.py",
    "nativeStages": [
      "multi-source-fetch",
      "url-normalization",
      "cross-source-deduplication"
    ],
    "stopWhenUnavailable": true,
    "discoveryCatalog": "discovery-queries.json",
    "languagePolicy": "any-reliable-language",
    "seedLanguages": [
      "en",
      "zh-CN",
      "ja",
      "ko"
    ],
    "coverageMode": "additive-broad-ai-ecosystem",
    "preserveExistingCoverage": true,
    "examplesAreAliasesNotScopeLimits": true,
    "coverageDomains": [
      "frontier-models-and-products",
      "developer-ai-and-agents",
      "open-and-multimodal-models",
      "chips-storage-and-semiconductor-equipment",
      "gpu-graphics-and-generative-rendering",
      "consumer-and-on-device-ai",
      "robotics-and-autonomous-driving",
      "applied-ai-products-and-industries",
      "data-center-energy-cooling-and-networking",
      "major-tech-finance",
      "ai-policy-and-safety"
    ],
    "queryConcurrency": 2,
    "candidateIndexRequired": true,
    "coverageManifestRequired": true,
    "coverageManifestSchemaVersion": 2,
    "requiredQueryFailurePolicy": "fail-closed",
    "requiredQueryResultLimitProbe": "request-maxResults-plus-one",
    "coverageReview": {
      "reviewEveryRequiredQuery": true,
      "reviewEveryRequiredGroup": true,
      "priorityGroupsFirst": true,
      "mustReviewCandidateSource": "coverage_manifest.json.mustReviewCandidateIds",
      "mustReviewScope": "all-discovered-candidates",
      "priorityReviewPolicy": "all-discovered-candidates",
      "priorityCandidateReviewRequired": true,
      "protectedEventReviewPolicy": "evidence-backed-protected-events-v1",
      "protectedEventReviewEffectiveReportDate": "2026-08-07",
      "protectedEventReviewScope": "all-editorial-signal-rss-protected-class-selected-and-merged-candidates",
      "protectedEventReviewRequiredRegardlessOfSelectedCount": true,
      "lowVolumeTrigger": 5,
      "lowVolumeMeaning": "selected-story-count",
      "lowVolumeAction": "mandatory-second-pass-then-fail-closed-below-minimum"
    },
    "editorialReview": {
      "policy": "programmatic-prescreen-codex-editorial-v1",
      "prepareEntrypoint": "npm.cmd run ai-news:semantic-review -- --run-dir <run-dir>",
      "queueArtifact": "codex_editorial_review.queue.json",
      "responseArtifact": "codex_editorial_review.response.json",
      "finalizeEntrypoint": "npm.cmd run ai-news:semantic-review -- --run-dir <run-dir> --finalize <response-json>",
      "editorialJudge": "current-scheduled-codex-task",
      "localSemanticModelAllowed": false,
      "programmaticPrescreenScope": "objective-window-content-source-and-protected-change-signal-checks-only",
      "editorialSignalAndRssBypassPrescreen": true,
      "combinedDispositionScope": "exactly-all-candidate-index-items-once",
      "finalizeChecks": [
        "editorial-signal-to-class-mapping",
        "event-member-class-status-substantive-change-and-score-consistency",
        "reliable-first-publication-window-to-rejection-reason-consistency",
        "confirmed-score-6-and-rumor-score-5-selection-thresholds"
      ],
      "localAuthoringCorrectionPolicy": "repair-the-upstream-response-or-editorial-package-and-rerun-every-affected-gate; never-close-with-an-unapplied-edit",
      "failClosed": true
    }
  },
  "selection": {
    "importanceThreshold": 6,
    "maxItems": null,
    "dedupeWithinRun": true,
    "dedupeLookbackDays": 30,
    "allowRepeatOnlyForMaterialUpdate": true,
    "eventDedupe": {
      "identity": "eventKey-plus-eventStage",
      "requiredFields": [
        "eventKey",
        "eventStage",
        "dedupeDecision"
      ],
      "allowedDecisions": [
        "new",
        "material-update",
        "duplicate"
      ],
      "selectedDuplicateAllowed": false,
      "selectedAndMergedPriorityDecisionsRequireEventIdentityEffectiveReportDate": "2026-08-13",
      "mergedMustMatchRepresentativeEventIdentity": true,
      "secondaryTitleMentionNeverEstablishesMergeIdentity": true,
      "materialUpdateRequires": [
        "priorStoryKey",
        "materialDifference"
      ],
      "materialStages": [
        "announcement",
        "preview",
        "release",
        "weights-release",
        "license",
        "technical-report",
        "deployment",
        "financing",
        "regulatory-decision"
      ]
    },
    "coverageAuditRequired": true,
    "coverageAuditContract": {
      "requiredFields": [
        "candidateIndexReviewedAt",
        "candidateIndexSha256",
        "lowVolumeTrigger",
        "signedOffQueryIds",
        "signedOffGroupIds",
        "priorityReview",
        "protectedEventReview",
        "secondPass"
      ],
      "priorityReviewWhen": "coverage-manifest-declares-mustReviewCandidateIds",
      "priorityReviewScope": "exactly-every-mustReviewCandidateId-once",
      "protectedEventReviewWhen": "coverage-manifest-declares-evidence-backed-protected-events-v1",
      "protectedEventReviewScope": "exactly-all-editorial-signal-rss-protected-class-selected-and-merged-candidates-once",
      "protectedEventReviewIndependentOfLowVolumeSecondPass": true,
      "signoffSource": "coverage_manifest.json",
      "signedOffQueryIds": "exactly-all-requiredQueryIds",
      "signedOffGroupIds": "exactly-all-requiredGroupIds",
      "secondPassWhen": "selected-story-count-below-5",
      "secondPassRepeatsAllRequiredSignoffs": true,
      "secondPassCompletedAt": "strictly-after-candidateIndexReviewedAt",
      "secondPassReconsideredCandidateIds": "must-include-all-editorial-signal-candidates-plus-all-rss-candidates-plus-protected-class-score-5-or-6-rejections; additional-index-candidates-allowed"
    },
    "priorityReviewContract": {
      "decisions": [
        "selected",
        "merged",
        "rejected"
      ],
      "requiredDecisionFields": [
        "candidateId",
        "decision",
        "editorialClass",
        "substantiveChange",
        "score"
      ],
      "score": {
        "reach": [
          0,
          2
        ],
        "magnitude": [
          0,
          3
        ],
        "practicalValue": [
          0,
          3
        ],
        "evidence": [
          0,
          2
        ],
        "total": [
          0,
          10
        ],
        "totalMustEqualComponentSum": true
      },
      "editorialClasses": [
        "major-model-product",
        "capability-availability",
        "usage-policy",
        "developer-tool",
        "material-price-quota",
        "strategic-hardware-infrastructure",
        "major-tech-finance",
        "ai-policy-safety",
        "other"
      ],
      "protectedEditorialClasses": [
        "major-model-product",
        "capability-availability",
        "usage-policy",
        "developer-tool",
        "material-price-quota",
        "strategic-hardware-infrastructure",
        "major-tech-finance",
        "ai-policy-safety"
      ],
      "protectedSelectionThreshold": 6,
      "protectedAtOrAboveThreshold": "must-be-selected-or-merged",
      "protectedSelectedOrMergedRequiresSubstantiveChange": true,
      "candidateEditorialSignals": {
        "major-model-product-change": {
          "requiredEditorialClass": [
            "major-model-product"
          ]
        },
        "capability-availability-change": {
          "requiredEditorialClass": [
            "capability-availability"
          ]
        },
        "developer-tool-change": {
          "requiredEditorialClass": [
            "developer-tool"
          ]
        },
        "material-price-quota-change": {
          "requiredEditorialClass": [
            "material-price-quota"
          ]
        },
        "strategic-hardware-infrastructure-change": {
          "requiredEditorialClass": [
            "strategic-hardware-infrastructure"
          ]
        },
        "major-tech-finance-change": {
          "requiredEditorialClass": [
            "major-tech-finance"
          ]
        },
        "ai-policy-safety-change": {
          "requiredEditorialClass": [
            "ai-policy-safety"
          ]
        },
        "usage-policy-change": {
          "requiredEditorialClass": [
            "usage-policy",
            "material-price-quota"
          ],
          "forbiddenRejectionReasons": [
            "below-importance-threshold",
            "routine-or-promotional",
            "outside-editorial-scope"
          ]
        }
      },
      "signalCombinationPolicy": {
        "specializedPrecedence": [
          "usage-policy-change",
          "material-price-quota-change",
          "major-tech-finance-change",
          "ai-policy-safety-change",
          "strategic-hardware-infrastructure-change"
        ],
        "compatibleProductSignalClasses": [
          "major-model-product",
          "capability-availability",
          "developer-tool"
        ],
        "rule": "highest-precedence-specialized-signal-wins; otherwise-any-present-compatible-product-class-is-allowed"
      },
      "selectedRequires": [
        "storyKey",
        "sourceCandidateIds"
      ],
      "mergedRequires": [
        "representativeCandidateId",
        "representative-decision-selected",
        "representative-sourceCandidateIds-includes-merged-candidate"
      ],
      "rejectedRequires": [
        "rejectionReason",
        "note"
      ],
      "allowedRejectionReasons": [
        "insufficient-evidence",
        "below-importance-threshold",
        "routine-or-promotional",
        "outside-editorial-scope",
        "outside-publication-window",
        "no-material-change"
      ],
      "rejectionSemanticRules": {
        "below-importance-threshold": "substantiveChange-must-be-true",
        "no-material-change": "substantiveChange-must-be-false"
      },
      "reviewIntegrity": {
        "minimumCandidateCount": 50,
        "rejectAllOtherClassification": true,
        "rejectDominantIdenticalRejectedEditorialClassAndScoreSignatureRatio": 0.9,
        "rejectRotatingScorePaletteMaximum": 8,
        "rejectRotatingNarrativePaletteMaximum": 32
      },
      "protectedCandidatesMayBeRejected": false
    },
    "protectedEventReviewContract": {
      "policy": "evidence-backed-protected-events-v1",
      "effectiveReportDate": "2026-08-07",
      "requiredCandidateScope": [
        "editorialSignals",
        "rss-source",
        "protected-editorial-class",
        "selected",
        "merged"
      ],
      "eventIdentity": "eventKey-plus-eventStage",
      "candidateCoverage": "exactly-once",
      "dispositions": [
        "selected",
        "rejected"
      ],
      "verificationStatuses": [
        "verified-in-window",
        "verified-outside-window",
        "insufficient-evidence"
      ],
      "verifiedRequires": [
        "firstReliablePublishedAt",
        "directReliableHttpsSourceUrls",
        "evidenceSummary",
        "fourComponentScoreRationale"
      ],
      "discoveryOnlyEvidenceHostsForbidden": [
        "news.google.com",
        "reddit.com",
        "news.ycombinator.com",
        "bing.com"
      ],
      "selectedRequiresVerifiedInWindow": true,
      "insufficientEvidenceMustNotInventFirstPublicationTime": true,
      "completedAt": "strictly-after-candidateIndexReviewedAt"
    },
    "minimumSelectedStories": 5,
    "minimumSelectedStoriesEffectiveReportDate": "2026-08-10",
    "minimumRumorStories": 0,
    "relaxedRumorPolicyEffectiveReportDate": "2026-08-13",
    "lowerRumorGateEffectiveReportDate": "2026-08-24",
    "confirmedStoryMinimumScore": 6,
    "rumorStoryMinimumScore": 5,
    "rumorEvidenceBases": [
      "attributed-first-party-teaser",
      "two-independent-reliable-reports",
      "one-attributed-reliable-report"
    ],
    "lowVolumeTrigger": 5,
    "lowVolumeRule": "Fewer than five selected stories requires a complete second coverage pass and then fails closed without publication if the run still has fewer than five; the importance threshold never drops and filler is forbidden.",
    "editorialScoring": "Codex applies Horizon-compatible importance criteria to the current Horizon candidate artifact",
    "selectedItemContract": {
      "requiredFields": [
        "section",
        "verification",
        "aiTake",
        "sourceCandidateIds"
      ],
      "aiTakeStyle": "brief-specific-useful",
      "aiTakeMinCharacters": 12,
      "aiTakeSentenceRange": [
        1,
        2
      ],
      "aiTakeMaxCharacters": 240
    },
    "sections": {
      "order": [
        "lead",
        "main",
        "rumor"
      ],
      "lead": {
        "exactItems": 1,
        "verification": "confirmed"
      },
      "main": {
        "maxItems": null,
        "verification": "confirmed"
      },
      "rumor": {
        "minimumItems": 0,
        "maxItems": null,
        "minimumIsFloorNotQuota": true,
        "retainAllThresholdClearingItems": true,
        "verification": "unverified",
        "requiresWhyUnverified": true,
        "minimumScore": 5,
        "allowsAttributedFirstPartyTeaser": true,
        "allowsTwoIndependentReliableReports": true,
        "allowsOneAttributedReliableReportEffectiveReportDate": "2026-08-24"
      }
    }
  },
  "evidence": {
    "preferPrimarySources": true,
    "allowRumors": true,
    "rumorPolicy": "Effective 2026-08-24, the isolated rumor section has no item-count floor and uses score 5. A rumor may be supported by an attributed first-party public teaser, one attributable reliable direct report, or at least two independent reliable direct reports. Conditional language and a specific whyUnverified remain mandatory; no rumor may be stated as fact or filled from discovery-only aggregators, anonymous screenshots, duplicates, or pure speculation.",
    "keepSourceUrlsInternalOnly": true
  },
  "article": {
    "styleGuide": "ARTICLE_STYLE.md",
    "format": "single-complete-article",
    "languages": [
      "zh",
      "en",
      "ja"
    ],
    "includeLinks": false,
    "includeReferencesSection": false,
    "includeScores": false,
    "includeSourceLabels": false,
    "titlePatterns": {
      "zh": "每日 AI 新闻｜<今日要闻标题>",
      "en": "Daily AI News | <Lead Story headline>",
      "ja": "毎日AIニュース｜<今日のトップニュース見出し>"
    },
    "titleUsesLeadStoryHeadline": true,
    "titleIncludesDate": false,
    "intro": {
      "allowed": false,
      "firstContentAfterTitle": "lead-section-heading",
      "windowDetailsInternalOnly": true
    },
    "tableOfContents": {
      "generatedBySite": true,
      "manualTableOfContents": false,
      "sourceHeadings": "story-headings-only",
      "includeEveryStoryHeading": true,
      "requireUniqueStoryHeadings": true
    },
    "sectionOrder": [
      "lead",
      "main",
      "rumor"
    ],
    "storyFormat": {
      "headingLevel": 3,
      "headlineStyle": "neutral-factual-no-clickbait",
      "bodyStyle": "fact-first-neutral",
      "preferredBodyParagraphs": 1,
      "preferredBodySentenceRange": [
        1,
        3
      ],
      "attributePublisherClaims": true
    },
    "requirePerItemAiTake": true,
    "aiTake": {
      "sentenceRange": [
        1,
        2
      ],
      "mustBeShorterThanStoryBody": true,
      "maxStoryBodyLengthRatio": 0.8,
      "allowedFocus": [
        "impact",
        "cost-or-access-threshold",
        "hidden-limit",
        "next-evidence"
      ],
      "forbidNewsRestatement": true,
      "forbidGenericFiller": true,
      "forbidForcedCriticism": true,
      "forbidUnsupportedFacts": true
    },
    "rumorPresentation": {
      "useConditionalLanguage": true,
      "forbidPerItemVerificationLabel": true,
      "sectionHeadingIsSufficientDisclosure": true
    },
    "endAfterRumorSection": true,
    "rumorsExcludedFromHeadlineAndOverallConclusion": true
  },
  "delivery": {
    "target": "daily-ai-news",
    "mode": "production-auto-publish",
    "endpoint": "/api/automation/daily-ai-news",
    "productionOrigin": "https://lusu575.com",
    "tokenEnvironmentVariable": "DAILY_AI_NEWS_TOKEN",
    "expectedResponseStatus": "published",
    "postPublishVerification": {
      "languages": [
        "zh",
        "en",
        "ja"
      ],
      "requiredFields": [
        "slug",
        "category",
        "lang",
        "title",
        "content_markdown"
      ],
      "mustFinishBeforeDeadline": true,
      "retry": {
        "method": "GET-only",
        "maxAttemptsPerLanguage": 3,
        "transientFailures": [
          "network-error",
          408,
          425,
          429,
          500,
          502,
          503,
          504
        ],
        "payloadMismatchRetry": false,
        "productionPostRetry": false
      }
    },
    "autoPublish": true,
    "schedulerEnabled": true,
    "failurePolicy": "fail-closed",
    "automaticLatePublishForbidden": false,
    "sameReportDatePublicationAllowedAfter08": true,
    "manualRecoveryReference": "MANUAL_RECOVERY.md"
  },
  "compatibility": {
    "formalRunSchemaVersion": 4,
    "historicalOneShotSchemaVersion": 3,
    "historicalSchema3OnlyForExplicitOneShot": true
  }
}
