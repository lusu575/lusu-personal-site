{
  "scripts": {
    "build": "node scripts/build-check.mjs",
    "build:transfer-icons": "node scripts/build-transfer-icon-atlas.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:production:verify": "node scripts/build-production.mjs --verify-reproducible",
    "audit:public-ui": "node scripts/public-ui-audit.mjs",
    "audit:resources-layout": "node scripts/public-ui-audit.mjs --resources-only",
    "audit:public-ui:release": "node scripts/public-ui-audit.mjs --release-only",
    "qa:public-release": "npm run verify:public-site-release",
    "verify:public-site-release": "npm run test && npm run check:public-modules && npm run build && npm run build:production:verify && git diff --check && git status --short && npm run audit:public-ui:release",
    "check:public-modules": "node scripts/check-public-module-graph.mjs",
    "dev": "wrangler pages dev",
    "transfer:dev": "wrangler pages dev --r2 TRANSFER_BUCKET",
    "test": "node scripts/run-tests.mjs tests/*.test.mjs tests/transfer/*.test.mjs tools/japanese-subtext/tests/*.test.mjs tools/japanese-subtext/scripts/tts/tests/*.mjs",
    "d1:create": "wrangler d1 create lusu_personal_site",
    "d1:migrate:local": "node scripts/d1-migrate-local.mjs",
    "d1:migrate:remote": "node scripts/d1-migrate-remote.mjs",
    "transfer:test": "node --test tests/transfer/*.test.mjs",
    "transfer:cleanup:dev": "wrangler dev --config workers/transfer-cleanup/wrangler.jsonc",
    "deploy": "echo Merge to GitHub main to trigger Cloudflare Pages automatic deploy.",
    "jp-subtext:build": "node tools/japanese-subtext/scripts/build-content.mjs",
    "jp-subtext:validate": "node tools/japanese-subtext/scripts/validate-content.mjs",
    "jp-subtext:validate:content": "node tools/japanese-subtext/scripts/validate-content.mjs --skip-audio",
    "jp-subtext:validate:draft": "node tools/japanese-subtext/scripts/validate-content.mjs --skip-audio --allow-partial --allow-unlocked",
    "jp-subtext:stats": "node tools/japanese-subtext/scripts/content-stats.mjs",
    "jp-subtext:illustrations": "node tools/japanese-subtext/scripts/generate-manga-assets.mjs",
    "jp-subtext:test": "node scripts/run-tests.mjs tools/japanese-subtext/tests/*.test.mjs tools/japanese-subtext/scripts/tts/tests/*.mjs",
    "jp-subtext:audio:validate": "node tools/japanese-subtext/scripts/validate-audio.mjs",
    "jp-subtext:audio:validate:quick": "node tools/japanese-subtext/scripts/validate-audio.mjs --skip-probe",
    "jp-subtext:audio:estimate": "node tools/japanese-subtext/scripts/estimate-audio-size.mjs",
    "jp-subtext:audio:merge": "node tools/japanese-subtext/scripts/merge-audio-manifests.mjs",
    "jp-subtext:release-check": "npm run jp-subtext:validate && npm run jp-subtext:audio:validate -- --check-silence && npm run jp-subtext:test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "sharp": "0.34.5",
    "wrangler": "4.111.0"
  }
}
