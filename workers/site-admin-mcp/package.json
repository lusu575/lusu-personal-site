{
  "name": "@lusu575/site-admin-mcp-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "deploy": "npm run deploy:preflight && wrangler deploy",
    "deploy:dry-run": "npm run deploy:preflight && wrangler deploy --dry-run",
    "deploy:preflight": "node scripts/assert-deploy-ready.mjs",
    "dev": "wrangler dev --compatibility-date 2026-07-29",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@types/node": "26.1.2",
    "typescript": "5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.16"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.0.9"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    },
    "undici": "7.29.0",
    "lodash-es": "4.18.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
